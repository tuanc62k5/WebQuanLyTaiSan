@using DoAn.Areas.Admin.Models
@using DoAn.Services.Assets
@model AssetFieldsViewModel
@if (!Model.DanhMucs.Any())
{
    <div class="col-12"><div class="alert alert-warning">Chưa có danh mục đang hoạt động. Vui lòng bổ sung danh mục trước khi thêm tài sản.</div></div>
}
<div class="col-md-6">
    <label asp-for="Ten" class="form-label"></label><input asp-for="Ten" class="form-control" maxlength="150" required />
    <span asp-validation-for="Ten" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="DanhMucId" class="form-label"></label>
    <select asp-for="DanhMucId" asp-items="Model.DanhMucs" class="form-select" required><option value="">Chọn danh mục</option></select>
    <span asp-validation-for="DanhMucId" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="NguyenGia" class="form-label"></label><input asp-for="NguyenGia" type="number" step="0.01" min="0" max="9999999999999.99" class="form-control" required />
    <span asp-validation-for="NguyenGia" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="NgayMua" class="form-label"></label><input asp-for="NgayMua" type="date" min="1900-01-01" max="@AssetDisplay.Today.ToString("yyyy-MM-dd")" class="form-control" />
    <span asp-validation-for="NgayMua" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="HanBaoHanh" class="form-label"></label><input asp-for="HanBaoHanh" type="date" class="form-control" />
    <span asp-validation-for="HanBaoHanh" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="TinhTrang" class="form-label"></label>
    <select asp-for="TinhTrang" class="form-select">@foreach (var item in AssetConditions.Labels) { <option value="@item.Key">@item.Value</option> }</select>
    <span asp-validation-for="TinhTrang" class="text-danger"></span>
</div>
<div class="col-12">
    <label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" class="form-control" rows="3" maxlength="10000"></textarea>
    <span asp-validation-for="MoTa" class="text-danger"></span>
</div>
<div class="col-12">
    <label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" class="form-control" rows="3" maxlength="10000"></textarea>
    <span asp-validation-for="GhiChu" class="text-danger"></span>
</div>
