@model DoAn.Models.tblPhongBan

@{
    ViewData["Title"] = "Thêm phòng ban";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Thêm phòng ban</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="PhongBan" asp-action="Index">Quản lý phòng ban</a></li>
                <li class="breadcrumb-item active">Thêm mới</li>
            </ol>
        </nav>
    </div>

    <div class="card">
        <div class="card-body">
            <h2 class="card-title">Thông tin phòng ban mới</h2>
            <form asp-area="Admin" asp-controller="PhongBan" asp-action="Create" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                <div class="col-md-6">
                    <label asp-for="PB_MaPhongBan" class="form-label">Mã phòng ban</label>
                    <input asp-for="PB_MaPhongBan" class="form-control" placeholder="VD: PB01" maxlength="30" required />
                    <span asp-validation-for="PB_MaPhongBan" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PB_TenPhongBan" class="form-label">Tên phòng ban</label>
                    <input asp-for="PB_TenPhongBan" class="form-control" placeholder="Nhập tên phòng ban..." maxlength="150" required />
                    <span asp-validation-for="PB_TenPhongBan" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PB_NguoiPhuTrach" class="form-label">Người phụ trách</label>
                    <input asp-for="PB_NguoiPhuTrach" class="form-control" placeholder="Họ tên người quản lý..." />
                </div>

                <div class="col-md-6">
                    <label asp-for="PB_SoDienThoai" class="form-label">Số điện thoại</label>
                    <input asp-for="PB_SoDienThoai" class="form-control" placeholder="Số điện thoại liên hệ..." />
                </div>

                <div class="col-md-6">
                    <label asp-for="PB_TrangThai" class="form-label">Trạng thái</label>
                    <select asp-for="PB_TrangThai" class="form-select">
                        <option value="true">Hoạt động</option>
                        <option value="false">Ngừng hoạt động</option>
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="PB_DiaChi" class="form-label">Địa chỉ / Vị trí phòng</label>
                    <textarea asp-for="PB_DiaChi" class="form-control" rows="2" placeholder="Nhập địa chỉ phòng ban..."></textarea>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Lưu lại</button>
                    <a asp-area="Admin" asp-controller="PhongBan" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</main>